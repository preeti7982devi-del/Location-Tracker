<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Location Tracker</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }

        .container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            padding: 40px;
            max-width: 500px;
            width: 100%;
            text-align: center;
        }

        h1 {
            color: #333;
            margin-bottom: 10px;
            font-size: 2.2em;
        }

        .subtitle {
            color: #666;
            margin-bottom: 30px;
            font-size: 1.1em;
        }

        .status {
            padding: 15px;
            border-radius: 10px;
            margin: 20px 0;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .status.success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .status.error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .status.info {
            background: #d1ecf1;
            color: #0c5460;
            border: 1px solid #bee5eb;
        }

        button {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 15px 30px;
            font-size: 1.1em;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.3s ease;
            margin: 10px;
            min-width: 150px;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

        button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        .location-info {
            background: #f8f9fa;
            border-radius: 15px;
            padding: 25px;
            margin: 20px 0;
            text-align: left;
            display: none;
        }

        .coord {
            font-family: 'Courier New', monospace;
            font-size: 1.2em;
            color: #667eea;
            margin: 10px 0;
            padding: 10px;
            background: white;
            border-radius: 8px;
            border-left: 4px solid #667eea;
        }

        .map-container {
            height: 300px;
            border-radius: 15px;
            overflow: hidden;
            margin: 20px 0;
            display: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        #map {
            height: 100%;
            width: 100%;
        }

        .privacy-notice {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            border-radius: 10px;
            padding: 15px;
            margin-top: 20px;
            font-size: 0.9em;
            color: #856404;
        }

        .share-link {
            margin: 20px 0;
            padding: 15px;
            background: #e9ecef;
            border-radius: 10px;
            word-break: break-all;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>📍 Location Tracker</h1>
        <p class="subtitle">Share your real-time location securely</p>
        
        <div id="status" class="status info">Click "Start Tracking" to share your location</div>
        
        <div>
            <button id="startBtn">Start Tracking</button>
            <button id="stopBtn" disabled>Stop Tracking</button>
        </div>

        <div id="locationInfo" class="location-info">
            <h3>📋 Current Location</h3>
            <div id="coords" class="coord">Waiting for location...</div>
            <div id="accuracy" class="coord">Accuracy: --</div>
            <div id="timestamp" class="coord">Last updated: --</div>
        </div>

        <div id="mapContainer" class="map-container">
            <div id="map"></div>
        </div>

        <div id="shareLink" class="share-link" style="display: none;">
            Share this link: <span id="shareUrl"></span>
            <button onclick="copyShareLink()" style="float: right; padding: 8px 16px; font-size: 0.9em;">Copy Link</button>
        </div>

        <div class="privacy-notice">
            <strong>Privacy Notice:</strong> Location data is only stored locally in your browser. 
            No data is sent to any server without your explicit consent.
        </div>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"></script>
    
    <script>
        class LocationTracker {
            constructor() {
                this.watchId = null;
                this.map = null;
                this.marker = null;
                this.isTracking = false;
                this.shareUrl = `${window.location.href}?tracker=${Date.now()}`;
                
                this.initElements();
                this.initMap();
                this.bindEvents();
            }

            initElements() {
                this.startBtn = document.getElementById('startBtn');
                this.stopBtn = document.getElementById('stopBtn');
                this.status = document.getElementById('status');
                this.locationInfo = document.getElementById('locationInfo');
                this.mapContainer = document.getElementById('mapContainer');
                this.shareLink = document.getElementById('shareLink');
                this.shareUrlEl = document.getElementById('shareUrl');
            }

            initMap() {
                this.map = L.map('map').setView([0, 0], 13);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap contributors'
                }).addTo(this.map);
            }

            bindEvents() {
                this.startBtn.addEventListener('click', () => this.startTracking());
                this.stopBtn.addEventListener('click', () => this.stopTracking());
            }

            async startTracking() {
                if (!navigator.geolocation) {
                    this.showStatus('Geolocation is not supported by this browser.', 'error');
                    return;
                }

                this.showStatus('Requesting location access...', 'info');
                
                const options = {
                    enableHighAccuracy: true,
                    timeout: 10000,
                    maximumAge: 5000
                };

                try {
                    this.watchId = navigator.geolocation.watchPosition(
                        (position) => this.onLocationUpdate(position),
                        (error) => this.onLocationError(error),
                        options
                    );
                    
                    this.isTracking = true;
                    this.updateUI();
                    this.showStatus('✅ Location tracking active!', 'success');
                    
                } catch (error) {
                    this.showStatus('Failed to start tracking: ' + error.message, 'error');
                }
            }

            stopTracking() {
                if (this.watchId !== null) {
                    navigator.geolocation.clearWatch(this.watchId);
                    this.watchId = null;
                }
                
                this.isTracking = false;
                this.updateUI();
                this.showStatus('Tracking stopped.', 'info');
                this.locationInfo.style.display = 'none
